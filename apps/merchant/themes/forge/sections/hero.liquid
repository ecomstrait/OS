<section class="hero{% if settings.hero_image != blank %} hero--image{% endif %}"
  {%- if settings.hero_image != blank %} style="background-image:linear-gradient(90deg, rgba(23,24,26,.86) 0%, rgba(23,24,26,.58) 100%), url('{{ settings.hero_image | image_url: width: 2000 }}')"{% endif %}>
  <span class="hero__stripes" aria-hidden="true"></span>
  <div class="container hero__inner">
    <p class="eyebrow">{{ shop.name }} &mdash; Built to work</p>
    <h1 class="hero__heading">{{ settings.hero_heading }}</h1>
    <p class="hero__subheading">{{ settings.hero_subheading }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary btn-lg">{{ settings.hero_cta }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
