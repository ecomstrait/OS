<section class="section">
  <div class="container product">
    <div class="product__media">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | escape }}" width="1200" height="1200" loading="eager" style="border-radius:var(--radius)">
      {%- else -%}
        <div class="product__media-placeholder" style="border-radius:var(--radius)"></div>
      {%- endif -%}
    </div>

    <div class="product__info">
      <h1 class="product__title">{{ product.title }}</h1>
      <p class="product__price">{% render 'price', product: product %}</p>

      {%- form 'product', product -%}
        {%- unless product.has_only_default_variant -%}
          <div class="product__options">
            {%- for option in product.options_with_values -%}
              <label class="product__option">
                <span>{{ option.name }}</span>
                <select name="options[{{ option.name | escape }}]">
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              </label>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" name="add" class="btn btn-primary btn-lg" {% unless product.available %}disabled{% endunless %}>
          {%- if product.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
        </button>
      {%- endform -%}

      {%- assign variant = product.selected_or_first_available_variant -%}
      <table class="spec">
        <caption class="spec__caption">Specification</caption>
        <tbody>
          {%- if product.vendor != blank -%}
            <tr><th scope="row">Make</th><td>{{ product.vendor }}</td></tr>
          {%- endif -%}
          {%- if product.type != blank -%}
            <tr><th scope="row">Category</th><td>{{ product.type }}</td></tr>
          {%- endif -%}
          {%- if variant.sku != blank -%}
            <tr><th scope="row">Part no.</th><td>{{ variant.sku }}</td></tr>
          {%- endif -%}
          {%- if variant.weight > 0 -%}
            <tr><th scope="row">Weight</th><td>{{ variant.weight | weight_with_unit: variant.weight_unit }}</td></tr>
          {%- endif -%}
          <tr>
            <th scope="row">Availability</th>
            <td>{% if product.available %}In stock{% else %}Out of stock{% endif %}</td>
          </tr>
        </tbody>
      </table>

      {%- if product.description != blank -%}
        <div class="rte product__description">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
