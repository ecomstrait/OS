{%- liquid
  assign target = product
  if target == blank
    assign target = variant
  endif
-%}
{%- if target.compare_at_price > target.price -%}
  <span class="price price--sale">
    <s class="price__was">{{ target.compare_at_price | money }}</s>
    <span class="price__now">{{ target.price | money }}</span>
  </span>
{%- else -%}
  <span class="price">
    {%- if target.price_varies -%}From {% endif -%}{{ target.price | money }}
  </span>
{%- endif -%}
