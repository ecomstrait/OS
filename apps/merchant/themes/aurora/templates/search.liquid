<div class="container section">
  <h1 class="section-title">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products" aria-label="Search">
    <button type="submit" class="btn btn-primary">Search</button>
  </form>

  {%- if search.performed -%}
    <p class="muted">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}</p>
    <div class="grid grid-products">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {% render 'product-card', product: item %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
