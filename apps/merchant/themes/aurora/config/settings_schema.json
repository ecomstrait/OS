[
  {
    "name": "theme_info",
    "theme_name": "Aurora \u2014 EcomStrait",
    "theme_version": "1.0.0",
    "theme_author": "EcomStrait",
    "theme_documentation_url": "https://ecomstrait.com",
    "theme_support_url": "https://ecomstrait.com/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "store_name",
        "label": "Store name",
        "info": "Shown in the header and footer. Set by EcomStrait; overrides the Shopify shop name."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "text",
        "id": "logo_asset",
        "label": "Logo asset filename",
        "info": "Uploaded by EcomStrait; leave blank to use the logo picker above."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 140
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_brand",
        "label": "Brand",
        "default": "#10b981"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#3b82f6"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#0f172a"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Headings",
        "default": "assistant_n7"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "default": 12
      }
    ]
  },
  {
    "name": "Hero",
    "settings": [
      {
        "type": "text",
        "id": "hero_heading",
        "label": "Heading",
        "default": "Your brand, beautifully built"
      },
      {
        "type": "textarea",
        "id": "hero_subheading",
        "label": "Subheading",
        "default": "Curated products, fast shipping, and a store designed to convert."
      },
      {
        "type": "text",
        "id": "hero_cta",
        "label": "Button label",
        "default": "Shop now"
      },
      {
        "type": "image_picker",
        "id": "hero_image",
        "label": "Background image"
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "text",
        "id": "footer_text",
        "label": "Footer note",
        "default": "Powered by EcomStrait"
      }
    ]
  },
  {
    "name": "Content",
    "settings": [
      {
        "type": "text",
        "id": "announcement",
        "label": "Announcement bar",
        "info": "Shown above the header on every page. Leave blank to hide it."
      },
      {
        "type": "text",
        "id": "hero_image_url",
        "label": "Hero image URL",
        "info": "Set by EcomStrait from your media library. Overrides the hero image picker."
      },
      {
        "type": "text",
        "id": "hero_video_url",
        "label": "Hero video URL",
        "info": "Plays muted behind the hero. Overrides the hero image."
      },
      {
        "type": "text",
        "id": "about_heading",
        "label": "About heading"
      },
      {
        "type": "textarea",
        "id": "about_body",
        "label": "About text"
      },
      {
        "type": "text",
        "id": "about_image_url",
        "label": "About image URL"
      }
    ]
  }
]
