<div class="collection-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ blog.title }}</span>
    </nav>
    <h1 class="collection-hero__title">{{ blog.title }}</h1>
  </div>
</div>

<div class="section">
  <div class="container" style="max-width:820px">
    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="blog-list">
          {%- for article in blog.articles -%}
            <a href="{{ article.url }}" class="blog-card{% if article.image %} blog-card--media{% endif %}">
              {%- if article.image -%}
                <div class="blog-card__media">
                  <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | escape }}" width="600" height="450" loading="lazy" style="border-radius:var(--radius)">
                </div>
              {%- endif -%}
              <div class="blog-card__body">
                <p class="blog-card__date muted">{{ article.published_at | date: '%B %-d, %Y' }}</p>
                <h2 class="blog-card__title">{{ article.title }}</h2>
                {%- if article.excerpt != blank -%}
                  <p class="blog-card__excerpt muted">{{ article.excerpt | strip_html | truncate: 160 }}</p>
                {%- elsif article.content != blank -%}
                  <p class="blog-card__excerpt muted">{{ article.content | strip_html | truncate: 160 }}</p>
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="muted">Nothing published yet — check back soon.</p>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span class="is-current">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
