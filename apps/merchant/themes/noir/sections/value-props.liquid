<section class="section value-props">
  <div class="container grid grid-3">
    {%- for block in section.blocks -%}
      <div class="value-prop" {{ block.shopify_attributes }}>
        <h3 class="value-prop__title">{{ block.settings.title }}</h3>
        <p class="muted">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Complimentary shipping" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Delivered worldwide, tracked end to end." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value props",
      "blocks": [
        { "type": "item", "settings": { "title": "Complimentary shipping", "text": "Delivered worldwide, tracked end to end." } },
        { "type": "item", "settings": { "title": "Secure checkout", "text": "Encrypted payments you can trust." } },
        { "type": "item", "settings": { "title": "Considered returns", "text": "Not quite right? Return within 30 days." } }
      ]
    }
  ]
}
{% endschema %}
