{%- liquid
  assign hero_bg = settings.hero_image_url
  if hero_bg == blank and settings.hero_image != blank
    assign hero_bg = settings.hero_image | image_url: width: 2000
  endif
  assign slide_count = 0
-%}
<section class="hero{% if hero_bg != blank or settings.hero_video_url != blank %} hero--image{% endif %}" data-hero>
  {%- for i in (1..4) -%}
    {%- assign url_key = 'hero_media_' | append: i | append: '_url' -%}
    {%- assign kind_key = 'hero_media_' | append: i | append: '_kind' -%}
    {%- assign slide_url = settings[url_key] -%}
    {%- assign slide_kind = settings[kind_key] -%}
    {%- if slide_url != blank -%}
      {%- assign slide_count = slide_count | plus: 1 -%}
      {%- comment -%}
        Numbered settings, not a JSON array setting: stock Liquid has a
        filter to serialise to JSON but none to parse one back out of a text
        setting, so a fixed set of slots is what settingsFromPlan can
        actually hand this section (see shopify-theme.ts).
      {%- endcomment -%}
      <div class="hero__slide{% if forloop.first %} is-active{% endif %}" data-hero-slide
        {%- unless slide_kind == 'video' %} style="background-image:linear-gradient(180deg, rgba(11,11,12,.55), rgba(11,11,12,.88)), url('{{ slide_url }}')"{% endunless %}>
        {%- if slide_kind == 'video' -%}
          <video class="hero__video" src="{{ slide_url }}" autoplay muted loop playsinline aria-hidden="true"></video>
          <span class="hero__scrim" aria-hidden="true"></span>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%}
    No carousel slides configured — the legacy single image/video setting,
    same as before this section grew a carousel.
  {%- endcomment -%}
  {%- if slide_count == 0 -%}
    <div class="hero__slide is-active"{% if hero_bg != blank %} style="background-image:linear-gradient(180deg, rgba(11,11,12,.55), rgba(11,11,12,.88)), url('{{ hero_bg }}')"{% endif %}>
      {%- if settings.hero_video_url != blank -%}
        <video class="hero__video" src="{{ settings.hero_video_url }}" autoplay muted loop playsinline aria-hidden="true"></video>
        <span class="hero__scrim" aria-hidden="true"></span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="container hero__inner">
    <span class="hero__rule" aria-hidden="true"></span>
    <h1 class="hero__heading">{{ settings.hero_heading }}</h1>
    <p class="hero__subheading">{{ settings.hero_subheading }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary btn-lg">{{ settings.hero_cta }}</a>
  </div>

  {%- if slide_count > 1 -%}
    <div class="hero__dots" data-hero-dots>
      {%- for n in (1..slide_count) -%}
        <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" data-hero-dot aria-label="Show slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
