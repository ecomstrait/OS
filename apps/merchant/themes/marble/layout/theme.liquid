<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_brand }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {%- style -%}
      :root{
        --brand: {{ settings.color_brand }};
        --accent: {{ settings.color_accent }};
        --ink: {{ settings.color_text }};
        --bg: {{ settings.color_bg }};
        --radius: {{ settings.corner_radius }}px;
        --font-heading: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
        --font-body: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};

        /* Marble's palette skews pale, so a plan-supplied brand colour can be too
           light to sit text on. `--brand-deep` folds it toward the ink to keep
           button and link contrast safe whatever palette EcomAI produces. */
        --brand-deep: color-mix(in srgb, var(--brand) 42%, var(--ink));
        --stone: color-mix(in srgb, var(--brand) 12%, var(--bg));
        --stone-2: color-mix(in srgb, var(--accent) 22%, var(--bg));
        --line: color-mix(in srgb, var(--ink) 12%, transparent);
        --muted: color-mix(in srgb, var(--ink) 52%, var(--bg));
        --surface: var(--stone);
      }
      {{ settings.heading_font | font_face: font_display: 'swap' }}
      {{ settings.body_font | font_face: font_display: 'swap' }}
    {%- endstyle -%}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'theme.js' | asset_url | script_tag }}
  </head>

  <body class="template-{{ template.name }}">
    {% section 'announcement' %}
    {% section 'header' %}
    <main id="main" role="main">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
  </body>
</html>
