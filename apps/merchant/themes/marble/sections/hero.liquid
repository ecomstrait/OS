<section class="hero{% if settings.hero_image != blank %} hero--image{% endif %}"
  {%- if settings.hero_image != blank %} style="background-image:linear-gradient(180deg, rgba(255,255,255,.82), rgba(255,255,255,.66)), url('{{ settings.hero_image | image_url: width: 2000 }}')"{% endif %}>
  <div class="container hero__inner">
    <h1 class="hero__heading">{{ settings.hero_heading }}</h1>
    <span class="rule-center" aria-hidden="true"></span>
    <p class="hero__subheading">{{ settings.hero_subheading }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary btn-lg">{{ settings.hero_cta }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
