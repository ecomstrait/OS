<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">
      {%- if settings.logo_asset != blank -%}
        <img src="{{ settings.logo_asset | asset_url }}" alt="{{ shop.name | escape }}" style="width:{{ settings.logo_width }}px" width="{{ settings.logo_width }}" height="40" loading="eager">
      {%- elsif settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 480 }}" alt="{{ shop.name | escape }}" style="width:{{ settings.logo_width }}px" width="{{ settings.logo_width }}" height="40" loading="eager">
      {%- else -%}
        <span class="site-header__name">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="Primary">
      {%- for link in linklists.main-menu.links -%}
        <a href="{{ link.url }}" class="site-nav__link{% if link.active %} is-active{% endif %}">{{ link.title }}</a>
      {%- else -%}
        <a href="/collections/all" class="site-nav__link">Shop</a>
      {%- endfor -%}
    </nav>

    <a href="{{ routes.cart_url }}" class="site-header__cart" aria-label="Cart">
      Cart <span class="cart-count">{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
