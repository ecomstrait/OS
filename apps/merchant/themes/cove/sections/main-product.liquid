{%- assign current = product.selected_or_first_available_variant -%}
<section class="section">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span aria-hidden="true">/</span>
      {%- endif -%}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product" data-product>
      <div class="product__media">
        {%- if product.featured_image -%}
          <img class="product__image" data-gallery-main
               src="{{ product.featured_image | image_url: width: 1200 }}"
               srcset="{{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 1200 }} 1200w, {{ product.featured_image | image_url: width: 1800 }} 1800w"
               sizes="(max-width: 820px) 100vw, 50vw"
               alt="{{ product.featured_image.alt | escape }}"
               width="1200" height="1200" loading="eager"
               style="border-radius:var(--radius)">
        {%- else -%}
          <div class="product__media-placeholder" style="border-radius:var(--radius)"></div>
        {%- endif -%}

        {%- if product.images.size > 1 -%}
          {%- comment -%}
            Buttons, not links: they swap the image in place. Every image stays
            in the DOM so it is crawlable and the page still shows the full set
            if theme.js never runs.
          {%- endcomment -%}
          <div class="product__thumbs">
            {%- for image in product.images -%}
              <button type="button"
                      class="product__thumb{% if forloop.first %} is-active{% endif %}"
                      data-gallery-thumb
                      data-full="{{ image | image_url: width: 1200 }}"
                      data-alt="{{ image.alt | escape }}"
                      aria-label="Show image {{ forloop.index }}"
                      aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                <img src="{{ image | image_url: width: 200 }}" alt="" loading="lazy" width="200" height="200">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- if product.vendor != blank -%}
          <p class="product__vendor">{{ product.vendor }}</p>
        {%- endif -%}
        <h1 class="product__title">{{ product.title }}</h1>
        <p class="product__price" data-price>{% render 'price', product: product %}</p>

        {%- form 'product', product -%}
          {%- unless product.has_only_default_variant -%}
            <div class="product__options">
              {%- for option in product.options_with_values -%}
                <label class="product__option">
                  <span>{{ option.name }}</span>
                  {%- comment -%}
                    data-option-index ties the select to its position in
                    variant.options, so the lookup doesn't depend on DOM order.
                  {%- endcomment -%}
                  <select data-option-index="{{ forloop.index0 }}" name="options[{{ option.name | escape }}]">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </label>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <div class="product__buy">
            <div class="qty" data-qty>
              <button type="button" class="qty__step" data-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
              <input type="number" name="quantity" value="1" min="1" aria-label="Quantity">
              <button type="button" class="qty__step" data-qty-step="1" aria-label="Increase quantity">+</button>
            </div>

            {%- comment -%}
              The id is what Shopify actually adds to the cart. theme.js keeps
              it in step with the selects; without it the form still posts a
              real, in-stock variant rather than nothing.
            {%- endcomment -%}
            <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
            <button type="submit" name="add" class="btn btn-primary btn-lg product__add"
                    data-add-button
                    data-label-add="Add to cart"
                    data-label-sold-out="Sold out"
                    {% unless current.available %}disabled{% endunless %}>
              {%- if current.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
            </button>
          </div>
        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="rte product__description">{{ product.description }}</div>
        {%- endif -%}
      </div>

      {%- comment -%}
        Variant data for theme.js. `| json` escapes it safely, and the money
        formatting is done here because Liquid knows the shop's currency and
        the browser does not.
      {%- endcomment -%}
      <script type="application/json" data-variants>
        [
          {%- for v in product.variants -%}
            {
              "id": {{ v.id }},
              "options": {{ v.options | json }},
              "available": {{ v.available | json }},
              "price_formatted": {{ v.price | money | json }}
              {%- if v.image %}, "image": {{ v.image | image_url: width: 1200 | json }}{% endif -%}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      </script>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
