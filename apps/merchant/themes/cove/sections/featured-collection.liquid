<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Selected</p>
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="link-more">View all &rarr;</a>
    </div>

    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection == blank -%}{%- assign collection = collections.all -%}{%- endif -%}

    <div class="grid grid-products">
      {%- for product in collection.products limit: section.settings.count -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for product in (1..3) -%}
          <div class="product-card product-card--placeholder" style="border-radius:var(--radius)"></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This season's edit" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "min": 2, "max": 12, "step": 1, "label": "Products", "default": 6 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
