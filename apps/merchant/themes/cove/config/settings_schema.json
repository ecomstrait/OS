[
  {
    "name": "theme_info",
    "theme_name": "Cove — EcomStrait",
    "theme_version": "1.0.0",
    "theme_author": "EcomStrait",
    "theme_documentation_url": "https://ecomstrait.com",
    "theme_support_url": "https://ecomstrait.com/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "store_name",
        "label": "Store name",
        "info": "Shown in the header and footer. Set by EcomStrait; overrides the Shopify shop name."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "text",
        "id": "logo_asset",
        "label": "Logo asset filename",
        "info": "Uploaded by EcomStrait; leave blank to use the logo picker above."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 140
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Cove stays close to the page — colour is used sparingly on rules, prices and links so the layout and typography carry the design."
      },
      {
        "type": "color",
        "id": "color_brand",
        "label": "Brand",
        "default": "#38BDF8"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#6366F1"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#16233A"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#FBFCFD"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Headings",
        "default": "lora_n4"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "default": 6
      }
    ]
  },
  {
    "name": "Hero",
    "settings": [
      {
        "type": "text",
        "id": "hero_heading",
        "label": "Heading",
        "default": "Fewer things, chosen well"
      },
      {
        "type": "textarea",
        "id": "hero_subheading",
        "label": "Subheading",
        "default": "A slow, considered edit — with the story behind every piece we carry."
      },
      {
        "type": "text",
        "id": "hero_cta",
        "label": "Button label",
        "default": "Read the edit"
      },
      {
        "type": "image_picker",
        "id": "hero_image",
        "label": "Background image"
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "text",
        "id": "footer_text",
        "label": "Footer note",
        "default": "Powered by EcomStrait"
      }
    ]
  }
