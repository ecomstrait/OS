<a href="{{ product.url }}" class="product-card" style="border-radius:var(--radius)">
  <div class="product-card__media">
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" width="800" height="1000" loading="lazy">
    {%- else -%}
      <div class="product-card__placeholder"></div>
    {%- endif -%}
    {%- unless product.available -%}<span class="badge badge--soldout">Sold out</span>{%- endunless -%}
  </div>
  <div class="product-card__body">
    <span class="product-card__title">{{ product.title }}</span>
    <span class="product-card__price">{% render 'price', product: product %}</span>
  </div>
</a>
