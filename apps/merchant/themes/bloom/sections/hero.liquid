<section class="hero{% if settings.hero_image != blank %} hero--image{% endif %}"
  {%- if settings.hero_image != blank %} style="background-image:linear-gradient(135deg, rgba(255,255,255,.72), rgba(255,255,255,.42)), url('{{ settings.hero_image | image_url: width: 2000 }}')"{% endif %}>
  <span class="hero__blob hero__blob--a" aria-hidden="true"></span>
  <span class="hero__blob hero__blob--b" aria-hidden="true"></span>
  <div class="container hero__inner">
    <h1 class="hero__heading">{{ settings.hero_heading }}</h1>
    <p class="hero__subheading">{{ settings.hero_subheading }}</p>
    <a href="/collections/all" class="btn btn-primary btn-lg">{{ settings.hero_cta }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
