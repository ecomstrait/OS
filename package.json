{
  "name": "ecomstrait",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "dev:website": "pnpm --filter @ecomstrait/website dev",
    "dev:supplier": "pnpm --filter @ecomstrait/supplier dev",
    "build:website": "pnpm --filter @ecomstrait/website build",
    "build:supplier": "pnpm --filter @ecomstrait/supplier build"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
